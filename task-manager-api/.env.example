# Configurações de ambiente da Task Manager API
# Copie este arquivo para .env e preencha com valores reais em produção.

SECRET_KEY=sua-chave-secreta-forte-aqui
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=0

# Credenciais SMTP para envio de notificações (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@dominio.com
SMTP_PASSWORD=sua-senha-de-app-aqui
SMTP_ENABLED=0
